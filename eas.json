{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        // Les architectures embarquees sont filtrees par
        // plugins/abi-arm-seulement.js. On avait d'abord essaye ici un
        // -PreactNativeArchitectures : mesure sur l'APK, sans aucun effet.
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
